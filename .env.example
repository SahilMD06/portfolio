# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Leave EMPTY for local development: the app falls back to an embedded PGlite
# Postgres stored in ./.data/pgdata — no server or Docker required.
# In production set this to your Supabase / Neon / RDS pooled connection string.
DATABASE_URL=

# --- Admin bootstrap -------------------------------------------------------
# Used ONLY by `npm run db:seed` to create the first admin user.
# Change the password immediately after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long

# --- Sessions --------------------------------------------------------------
# Random 32+ byte secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Site ------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap, canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Object storage --------------------------------------------------------
# "local"    -> files written to ./.data/uploads (default; good for dev)
# "supabase" -> files written to a Supabase Storage bucket (recommended in prod)
STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media
# Public origin of the storage host, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_STORAGE_ORIGIN=
